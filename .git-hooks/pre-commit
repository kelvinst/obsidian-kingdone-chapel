#!/bin/sh

if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  echo "Commit rejected: there are unstaged or untracked changes."
  echo "Stage everything or stash before committing."
  echo ""
  echo "For stashing:"
  echo ""
  echo "  git stash push --keep-index --include-untracked -m pre-commit"
  echo "  git commit"
  echo "  git stash apply && git stash drop"
  exit 1
fi

# `.tool-versions` pins Node for mise and asdf, but git runs a hook through a
# plain shell, which may have neither activated — and a contributor may have
# neither installed. Left unchecked, the hook answers for the commit on one
# Node while CI answers for it on another, which is the one gap a check run
# before the commit cannot otherwise close.
want=$(awk '/^nodejs /{print $2}' .tool-versions)
have=$(node -v 2>/dev/null | sed 's/^v//')
if [ "$want" != "$have" ]; then
  echo "Commit rejected: Node ${have:-not found on PATH}, but .tool-versions pins $want."
  echo "CI runs the checks on $want, so this commit would be answered for on another."
  echo ""
  echo "  mise install    # then commit from a shell where mise is active"
  echo ""
  echo "asdf reads the same file. Without either, install Node $want."
  exit 1
fi

# What this commit is for, remembered before the checks can add to it. The
# formatter rewrites the whole tree, not only what was staged, so a file it
# fixes that nobody staged belongs to whoever left it unformatted rather than
# to this commit. Held in a file because a NUL cannot survive in a variable,
# and a path is allowed to contain anything but that.
staged=$(mktemp)
trap 'rm -f "$staged"' EXIT
git diff --cached --name-only -z --diff-filter=ACMR >"$staged"

make precommit || exit 1

# A rebase replays commits that were already answered for when they were made,
# and `git rebase --exec` runs this after each one is written. Staging there
# leaves an index the rebase cannot continue over, and the rewrite could not
# reach the commit it belongs to anyway — that commit already exists. So stop
# the rebase and say why, rather than folding anything in.
if [ -d "$(git rev-parse --git-path rebase-merge)" ] ||
  [ -d "$(git rev-parse --git-path rebase-apply)" ]; then
  git diff --quiet && exit 0
  echo "Rebase stopped: the checks rewrote files while replaying a commit."
  echo "Look at them, amend that commit, then continue:"
  echo ""
  echo "  git add -A && git commit --amend --no-edit"
  echo "  git rebase --continue"
  exit 1
fi

# Otherwise fold the fixes into the commit they were run for — only the paths
# that were staged a moment ago, plus the Vitest config, which a run that
# raised the coverage floors will have rewritten.
if [ -s "$staged" ]; then
  xargs -0 git add -- <"$staged"
fi
git add -- vitest.config.mts
